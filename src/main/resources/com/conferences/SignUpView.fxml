<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.conferences.controller.SignUpController"
            prefWidth="480" prefHeight="660"
            style="-fx-background-color: #FFFFFF;">

    <!-- Top Crimson Banner -->
    <top>
        <HBox alignment="CENTER" prefHeight="64" style="-fx-background-color: #9E0B28;">
            <Label text="%app.title"
                   style="-fx-text-fill: #FFFFFF; -fx-font-size: 20px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- Center Sign-Up Form -->
    <center>
        <VBox alignment="CENTER" spacing="10" maxWidth="320">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label fx:id="headingLabel" text="%signup.heading"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111111;"/>

            <!-- Language Selector -->
            <HBox alignment="CENTER" spacing="8">
                <Label fx:id="languageLabel" text="%lang.label"
                       style="-fx-font-size: 12px; -fx-text-fill: #222222;"/>
                <ComboBox fx:id="languageComboBox" prefWidth="120"
                          onAction="#handleLanguageChange"/>
            </HBox>

            <TextField fx:id="fullNameField" promptText="%signup.fullname.prompt"
                       prefHeight="36"
                       style="-fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 10 0 10;"/>

            <TextField fx:id="ageField" promptText="%signup.age.prompt"
                       prefHeight="36"
                       style="-fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 10 0 10;"/>

            <TextField fx:id="emailField" promptText="%signup.email.prompt"
                       prefHeight="36"
                       style="-fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 10 0 10;"/>

            <PasswordField fx:id="passwordField" promptText="%signup.password.prompt"
                           prefHeight="36"
                           style="-fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 10 0 10;"/>

            <PasswordField fx:id="confirmPasswordField" promptText="%signup.confirmPassword.prompt"
                           prefHeight="36"
                           style="-fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 10 0 10;"/>

            <Label fx:id="errorLabel" text="" wrapText="true"
                   style="-fx-text-fill: #C62828; -fx-font-size: 12px;"/>

            <Button fx:id="signupButton" text="%signup.button.submit"
                    onAction="#handleSignUp"
                    maxWidth="Infinity" prefHeight="36"
                    style="-fx-background-color: #9E0B28; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 4; -fx-cursor: hand;"/>

            <Button fx:id="switchToLoginButton" text="%signup.button.switchToLogin"
                    onAction="#handleSwitchToLogin"
                    maxWidth="Infinity" prefHeight="32"
                    style="-fx-background-color: #F5F5F5; -fx-text-fill: #222222; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4; -fx-cursor: hand;"/>
        </VBox>
    </center>

</BorderPane>