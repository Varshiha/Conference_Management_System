<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<GridPane alignment="CENTER" hgap="10" vgap="10" xmlns="http://javafx.com" xmlns:fx="http://xml.com" fx:controller="com.conferences.controllers.addUserController.java">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <!-- Columns -->
    <Label text="Full Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
    <TextField fx:id="txtName" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

    <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
    <TextField fx:id="txtEmail" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

    <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
    <TextField fx:id="txtPassword" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

    <Label text="Age:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
    <TextField fx:id="txtAge" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

    <Label text="Role:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
    <TextField fx:id="txtRole" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

    <!-- Buttons -->
    <HBox alignment="CENTER_RIGHT" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="10">
        <Button text="Add" onAction="#onAddSave" prefWidth="80"/>
        <Button text="Cancel" onAction="#onCancel" prefWidth="80"/>
    </HBox>
</GridPane>
