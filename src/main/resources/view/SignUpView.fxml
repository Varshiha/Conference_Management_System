<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="660" prefWidth="480" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.conferences.controller.SignUpController">

    <!-- Top Banner -->
    <top>
        <HBox alignment="CENTER" prefHeight="64" style="-fx-background-color: #9E0B28;">
            <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 20px; -fx-font-weight: bold;" text="%app.title" />
        </HBox>
    </top>

    <!-- Center Sign-Up Form -->
    <center>
        <VBox alignment="CENTER" maxWidth="320" spacing="10">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <Label fx:id="headingLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111111;" text="%signup.heading" />

            <!-- Language Selector -->
            <HBox alignment="CENTER" spacing="8">
                <Label fx:id="languageLabel" style="-fx-font-size: 12px; -fx-text-fill: #222222;" text="%lang.label" />
                <ComboBox fx:id="languageComboBox" onAction="#handleLanguageChange" prefWidth="120" />
            </HBox>

            <TextField fx:id="fullNameField" prefHeight="36" promptText="%signup.fullname.prompt" style="-fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 10 0 10;" />

            <TextField fx:id="ageField" prefHeight="36" promptText="%signup.age.prompt" style="-fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 10 0 10;" />

            <TextField fx:id="emailField" prefHeight="36" promptText="%signup.email.prompt" style="-fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 10 0 10;" />

            <PasswordField fx:id="passwordField" prefHeight="36" promptText="%signup.password.prompt" style="-fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 10 0 10;" />

            <PasswordField fx:id="confirmPasswordField" prefHeight="36" promptText="%signup.confirmPassword.prompt" style="-fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 10 0 10;" />

            <Label fx:id="errorLabel" style="-fx-text-fill: #C62828; -fx-font-size: 12px;" text="" wrapText="true" />

            <Button fx:id="signupButton" maxWidth="Infinity" onAction="#handleSignUp" prefHeight="36" style="-fx-background-color: #9E0B28; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 4; -fx-cursor: hand;" text="%signup.button.submit" />

            <Button fx:id="switchToLoginButton" maxWidth="Infinity" onAction="#handleSwitchToLogin" prefHeight="32" style="-fx-background-color: #F5F5F5; -fx-text-fill: #222222; -fx-border-color: #CCCCCC; -fx-border-radius: 4; -fx-background-radius: 4; -fx-cursor: hand;" text="%signup.button.switchToLogin" />
        </VBox>
    </center>

</BorderPane>
