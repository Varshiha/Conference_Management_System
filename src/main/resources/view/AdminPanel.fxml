<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SplitMenuButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="505.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.conferences.controller.AdminPanelController">
    <padding>
        <Insets bottom="15" left="15" right="15" top="10" />
    </padding>
    <top>
        <VBox spacing="15">
            <HBox alignment="CENTER_LEFT" prefHeight="67.0" style="-fx-background-color: #A20025; -fx-background-radius: 10px;">
                <padding>
                    <Insets left="20" right="20" />
                </padding>
                <Label fx:id="conferenceBannerLabel" text="%admin.banner" textFill="WHITE">
                    <font>
                        <Font name="Century Gothic Bold" size="25.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="adminHeadingLabel" text="%admin.panel.title" textFill="WHITE">
                    <font>
                        <Font name="Century Gothic" size="20.0" />
                    </font>
                </Label>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="welcomeLabel" text="%admin.welcome">
                    <font>
                        <Font name="Century Gothic" size="20.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="languageLabel" text="%lang.label" />
                <SplitMenuButton fx:id="englishSplitMenu" mnemonicParsing="false" prefHeight="30.0" prefWidth="110.0" text="English">
                    <items>
                        <MenuItem fx:id="englishMenuItem" mnemonicParsing="false" onAction="#englishLanguage" text="English" />
                        <MenuItem fx:id="frenchMenuItem" mnemonicParsing="false" onAction="#frenchLanguage" text="Français" />
                    </items>
                </SplitMenuButton>
                <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#goToLogPage" prefHeight="30.0" prefWidth="115.0" text="%admin.button.logout" />
            </HBox>
            <BorderPane.margin>
                <Insets bottom="15" />
            </BorderPane.margin>

        </VBox>
    </top>
    <center>
        <TableView fx:id="conferenceTableView" prefHeight="298.0">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="46.79995656013489" text="ID" />
                <TableColumn fx:id="titleColumn" prefWidth="197.5999984741211" text="%admin.column.title" />
                <TableColumn fx:id="capacityColumn" prefWidth="85.19999694824219" text="%admin.column.capacity" />
                <TableColumn fx:id="startColumn" prefWidth="142.39999389648438" text="%admin.column.start" />
                <TableColumn fx:id="endColumn" prefWidth="148.80001831054688" text="%admin.column.end" />
                <TableColumn fx:id="venueColumn" prefWidth="185.99993896484375" text="%admin.column.venue" />
                <TableColumn fx:id="confirmedColumn" prefWidth="113.60003662109375" text="%admin.column.confirmed" />
                <TableColumn fx:id="waitlistedColumn" prefWidth="101.60009765625" text="%admin.column.waitlisted" />
                <TableColumn fx:id="availableColumn" prefWidth="148.7999267578125" text="%admin.column.available" />
                <TableColumn fx:id="fullColumn" prefWidth="101.5999755859375" text="%admin.column.full" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
            </columnResizePolicy>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="10">
            <padding>
                <Insets top="20" />
            </padding>
            <Button fx:id="createButton" mnemonicParsing="false" onAction="#createConferencePage" prefHeight="30.0" prefWidth="135.0" text="%admin.button.create" />
            <Button fx:id="editButton" mnemonicParsing="false" onAction="#editConferencePage" prefHeight="30.0" prefWidth="125.0" text="%admin.button.edit" />
            <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#deleteConferencePage" prefHeight="30.0" prefWidth="143.0" text="%admin.button.delete" />
            <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#refreshConferencePage" prefHeight="30.0" prefWidth="141.0" text="%admin.button.refresh" />
            <Button fx:id="reportsButton" mnemonicParsing="false" onAction="#reportsPage" prefHeight="30.0" prefWidth="142.0" text="%admin.button.reports" />
        </HBox>
    </bottom>

</BorderPane>
