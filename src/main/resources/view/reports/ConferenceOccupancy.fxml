<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="222.0" prefWidth="460.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.conferences.controller.ConferenceOccupancyController">
   <children>
      <Label alignment="CENTER" layoutX="12.0" layoutY="14.0" prefHeight="25.0" prefWidth="436.0" style="-fx-background-color: #A20025; -fx-background-radius: 5px;" text="%report.occupancy" textFill="WHITE">
         <font>
            <Font name="Century Gothic Bold" size="14.0" />
         </font>
      </Label>
      <Label layoutX="20.0" layoutY="63.0" text="%report.select.conference" />
      <ComboBox fx:id="conferenceComboBox" layoutX="230.0" layoutY="59.0" prefHeight="25.0" prefWidth="215.0" />
      <Label layoutX="20.0" layoutY="109.0" text="%report.occupancy.number" />
      <TextField fx:id="numberTextField" layoutX="230.0" layoutY="105.0" prefHeight="25.0" prefWidth="215.0" editable="false" />
      <Label layoutX="20.0" layoutY="145.0" text="%report.occupancy.percentage" />
      <TextField fx:id="percentageTextField" layoutX="230.0" layoutY="141.0" prefHeight="25.0" prefWidth="215.0" editable="false" />
      <Button fx:id="viewButton" layoutX="245.0" layoutY="181.0" mnemonicParsing="false" onAction="#viewOccupancy" prefHeight="25.0" prefWidth="95.0" text="%report.button.view" />
      <Button fx:id="closeCOcButton" layoutX="350.0" layoutY="181.0" mnemonicParsing="false" onAction="#closeConferenceOccupancy" prefHeight="25.0" prefWidth="95.0" text="%report.button.close" />
   </children>
</AnchorPane>