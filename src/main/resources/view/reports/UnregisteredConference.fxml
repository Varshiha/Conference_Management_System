<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="309.0" prefWidth="420.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.conferences.controller.UnregisteredConferenceController">
   <children>
      <Label alignment="CENTER" layoutX="12.0" layoutY="14.0" prefHeight="25.0" prefWidth="396.0" style="-fx-background-color: #A20025; -fx-background-radius: 5px;" text="%report.unregistered" textFill="WHITE">
         <font>
            <Font name="Century Gothic Bold" size="14.0" />
         </font>
      </Label>
      <TableView fx:id="conferenceTableView" layoutX="12.0" layoutY="58.0" prefHeight="200.0" prefWidth="396.0">
         <columns>
            <TableColumn fx:id="idColumn" prefWidth="60.0" text="ID" />
            <TableColumn fx:id="titleColumn" prefWidth="334.0" text="%admin.column.title" />
         </columns>
      </TableView>
      <Button layoutX="205.0" layoutY="273.0" mnemonicParsing="false" onAction="#refreshConferenceTable" prefHeight="25.0" prefWidth="95.0" text="%admin.button.refresh" />
      <Button fx:id="closeUCButton" layoutX="310.0" layoutY="273.0" mnemonicParsing="false" onAction="#closeUnregisteredConference" prefHeight="25.0" prefWidth="95.0" text="%report.button.close" />
   </children>
</AnchorPane>