<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="361.0" prefWidth="420.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.conferences.controller.ParticipantRegisteredController">
   <children>
      <Label alignment="CENTER" layoutX="12.0" layoutY="14.0" prefHeight="25.0" prefWidth="396.0" style="-fx-background-color: #A20025; -fx-background-radius: 5px;" text="%report.registration" textFill="WHITE">
         <font>
            <Font name="Century Gothic Bold" size="14.0" />
         </font>
      </Label>
      <Label layoutX="20.0" layoutY="59.0" prefHeight="25.0" prefWidth="175.0" text="%report.select.participant" />
      <ComboBox fx:id="participantComboBox" layoutX="195.0" layoutY="59.0" prefHeight="25.0" prefWidth="210.0" />
      <TableView fx:id="conferenceTableView" layoutX="12.0" layoutY="104.0" prefHeight="200.0" prefWidth="396.0">
         <columns>
            <TableColumn fx:id="idColumn" prefWidth="60.0" text="ID" />
            <TableColumn fx:id="titleColumn" prefWidth="214.0" text="%admin.column.title" />
            <TableColumn fx:id="statusColumn" prefWidth="120.0" text="%report.column.status" />
         </columns>
      </TableView>
      <Button fx:id="viewButton" layoutX="205.0" layoutY="321.0" mnemonicParsing="false" onAction="#viewConferenceTable" prefHeight="25.0" prefWidth="95.0" text="%report.button.view" />
      <Button fx:id="closePRButton" layoutX="310.0" layoutY="321.0" mnemonicParsing="false" onAction="#closeParticipantRegistered" prefHeight="25.0" prefWidth="95.0" text="%report.button.close" />
   </children>
</AnchorPane>