<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="317.0" prefWidth="360.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.conferences.controller.EditConferenceController">
   <children>
      <Button fx:id="editButton" layoutX="125.0" layoutY="277.0" mnemonicParsing="false" onAction="#editConference" prefHeight="25.0" prefWidth="98.0" text="%conf.button.save" />
      <Button fx:id="cancelButton" layoutX="235.0" layoutY="277.0" mnemonicParsing="false" onAction="#cancelConference" prefHeight="25.0" prefWidth="98.0" text="%Cancel" />
      <Label alignment="CENTER" layoutX="16.0" layoutY="14.0" prefHeight="25.0" prefWidth="328.0" style="-fx-background-color: #A20025; -fx-background-radius: 5px;" text="%conf.edit.heading" textFill="WHITE">
         <font>
            <Font name="Century Gothic Bold" size="14.0" />
         </font>
      </Label>
      <Label layoutX="26.0" layoutY="50.0" prefHeight="25.0" prefWidth="140.0" text="%conf.field.title" />
      <TextField fx:id="titleTextField" layoutX="180.0" layoutY="50.0" prefHeight="25.0" prefWidth="153.0" />
      <Label layoutX="26.0" layoutY="82.0" prefHeight="25.0" prefWidth="140.0" text="%conf.field.capacity" />
      <TextField fx:id="capacityTextField" layoutX="180.0" layoutY="82.0" prefHeight="25.0" prefWidth="153.0" />
      <Label layoutX="26.0" layoutY="114.0" prefHeight="25.0" prefWidth="140.0" text="%conf.field.startDate" />
      <DatePicker fx:id="startDatePicker" layoutX="180.0" layoutY="114.0" prefHeight="25.0" prefWidth="153.0" />
      <Label layoutX="26.0" layoutY="147.0" prefHeight="25.0" prefWidth="140.0" text="%conf.field.startTime" />
      <ComboBox fx:id="startHourComboBox" layoutX="180.0" layoutY="147.0" prefHeight="25.0" prefWidth="67.0" />
      <Label alignment="CENTER" layoutX="247.0" layoutY="147.0" prefHeight="25.0" prefWidth="19.0" text=":" />
      <ComboBox fx:id="startMinuteComboBox" layoutX="266.0" layoutY="147.0" prefHeight="25.0" prefWidth="67.0" />
      <Label layoutX="26.0" layoutY="178.0" prefHeight="25.0" prefWidth="140.0" text="%conf.field.endDate" />
      <DatePicker fx:id="endDatePicker" layoutX="180.0" layoutY="178.0" prefHeight="25.0" prefWidth="153.0" />
      <Label layoutX="26.0" layoutY="209.0" prefHeight="25.0" prefWidth="140.0" text="%conf.field.endTime" />
      <ComboBox fx:id="endHourComboBox" layoutX="180.0" layoutY="209.0" prefHeight="25.0" prefWidth="67.0" />
      <Label alignment="CENTER" layoutX="247.0" layoutY="209.0" prefHeight="25.0" prefWidth="19.0" text=":" />
      <ComboBox fx:id="endMinuteComboBox" layoutX="266.0" layoutY="209.0" prefHeight="25.0" prefWidth="67.0" />
      <Label layoutX="26.0" layoutY="247.0" prefHeight="25.0" prefWidth="140.0" text="%conf.field.venue" />
      <TextField fx:id="venueTextField" layoutX="180.0" layoutY="247.0" prefHeight="25.0" prefWidth="153.0" />
   </children>
</AnchorPane>